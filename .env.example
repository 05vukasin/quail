# quail: LLM API settings for `summary.llm` through an API (quail-summary feature `api`,
# quail-cli feature `llm-api`). Copy to .env, fill in what you have, leave the rest empty.
# .env is git-ignored: never commit keys.
#
# quail reads this file only when you name it (`--env-file PATH`, `Env::with_file`); variables
# already set in the environment win over the file, and arguments (`--llm`, `--llm-model`)
# win over both. The names match hedgehog's .env.example, so one file serves both projects.
#
# Using an API sends document text (the card and the digest) to the provider you pick.

# Default provider/model when no `--llm PRESET` is given.
# AI_PROVIDER: openai | openai_compatible | anthropic | bedrock | openrouter | groq | vllm | ollama
AI_PROVIDER=
AI_CHAT_MODEL=

# --- OpenAI -----------------------------------------------------------------
OPENAI_API_KEY=
# Set to point the OpenAI client at any OpenAI-compatible server instead.
OPENAI_BASE_URL=
# Default for the openai preset: gpt-4o-mini
OPENAI_MODEL=

# --- Anthropic --------------------------------------------------------------
ANTHROPIC_API_KEY=
# claude-haiku-5-5 (default: cheap for bulk summaries) | claude-sonnet-5-5 | claude-opus-5-5
ANTHROPIC_MODEL=

# --- AWS Bedrock (Converse API, bearer token) --------------------------------
AI_BEDROCK_BEARER_TOKEN=
AI_BEDROCK_REGION=eu-west-2
# e.g. qwen.qwen3-235b-a22b-2507-v1:0
AI_BEDROCK_MODEL=

# --- OpenRouter (OpenAI-compatible) -----------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=

# --- Groq (OpenAI-compatible) -----------------------------------------------
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=

# --- Local / self-hosted OpenAI-compatible (vLLM, Ollama, LM Studio, llama-server) ---
# A fine-tuned model served by any of these is the `vllm` preset. /v1 is appended if missing.
API_URL=
API_TOKEN=
API_MODEL=

# --- Limits -------------------------------------------------------------------
# Max concurrent LLM calls across the process.
AI_MAX_CONCURRENT_LLM=4
